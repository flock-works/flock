# Copy this file to .env.google. Never commit .env.google.
FLOCK_COOKIE_SECRET=replace-with-output-from-openssl-rand-hex-32
FLOCK_PUBLIC_URL=https://flock.example.com
FLOCK_OIDC_ACCESS_MODE=google-open
FLOCK_OIDC_ADMIN_EMAILS=you@example.com
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=your-google-client-secret
FLOCK_NOUS_CLIENT_ID=your-nous-issued-flock-client-id
